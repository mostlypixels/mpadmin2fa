{% extends '@MailThemes/classic/components/layout.html.twig' %}

{% block title %}{{ 'PrestaShop back-office security alert'|trans({}, 'Emails.Body', locale) }}{% endblock %}

{% block content %}
<tr>
  <td align="center" class="titleblock">
    <font size="2" face="{{ languageDefaultFont }}Open-sans, sans-serif" color="#555454">
      <span class="title">{{ 'Back-office security alert'|trans({}, 'Emails.Body', locale) }}</span>
    </font>
  </td>
</tr>
<tr>
  <td class="space_footer">&nbsp;</td>
</tr>
<tr>
  <td class="box" style="border:1px solid #D6D4D4;">
    <table class="table">
      <tr>
        <td width="10">&nbsp;</td>
        <td>
          <font size="2" face="{{ languageDefaultFont }}Open-sans, sans-serif" color="#555454">
            <p><strong>{{ 'Event:'|trans({}, 'Emails.Body', locale) }}</strong> {event}</p>
            <div style="font-family:{{ languageDefaultFont }}Open-sans, sans-serif;font-size:14px;line-height:21px;">{details_html}</div>
          </font>
        </td>
        <td width="10">&nbsp;</td>
      </tr>
    </table>
  </td>
</tr>
<tr>
  <td class="space_footer">&nbsp;</td>
</tr>
<tr>
  <td class="linkbelow">
    <font size="2" face="{{ languageDefaultFont }}Open-sans, sans-serif" color="#555454">
      {{ 'Review the Admin 2FA security activity log in the back office.'|trans({}, 'Emails.Body', locale) }}
    </font>
  </td>
</tr>
{% endblock %}
