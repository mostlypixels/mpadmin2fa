{% extends '@MailThemes/modern/components/layout.html.twig' %}

{% block title %}{{ 'PrestaShop back-office security alert'|trans({}, 'Emails.Body', locale) }}{% endblock %}

{% block content %}
<div style="margin:0 auto;max-width:604px;">
  <table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;">
    <tbody>
      <tr>
        <td style="direction:{{ direction }};padding:0 25px 20px;text-align:{{ align_left }};">
          <div style="font-family:Open sans, arial, sans-serif;font-size:20px;font-weight:600;line-height:25px;color:#363A41;">
            {{ 'Back-office security alert'|trans({}, 'Emails.Body', locale) }}
          </div>
        </td>
      </tr>
      <tr>
        <td style="direction:{{ direction }};padding:0 25px 20px;text-align:{{ align_left }};">
          <div style="background:#fff3cd;border:1px solid #ffeeba;border-radius:4px;color:#856404;font-family:Open sans, arial, sans-serif;font-size:14px;line-height:21px;padding:14px;">
            <strong>{{ 'Event:'|trans({}, 'Emails.Body', locale) }}</strong> {event}
          </div>
        </td>
      </tr>
      <tr>
        <td style="direction:{{ direction }};padding:0 25px 20px;text-align:{{ align_left }};">
          <div style="color:#363A41;font-family:Open sans, arial, sans-serif;font-size:14px;line-height:21px;">{details_html}</div>
        </td>
      </tr>
      <tr>
        <td style="direction:{{ direction }};padding:0 25px 30px;text-align:{{ align_left }};">
          <div style="font-family:Open sans, arial, sans-serif;font-size:13px;line-height:20px;color:#68737f;">
            {{ 'Review the Admin 2FA security activity log in the back office.'|trans({}, 'Emails.Body', locale) }}
          </div>
        </td>
      </tr>
    </tbody>
  </table>
</div>
{% endblock %}
