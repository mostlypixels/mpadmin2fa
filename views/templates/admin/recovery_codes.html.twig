{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% form_theme acknowledgement_form '@PrestaShop/Admin/TwigTemplateForm/prestashop_ui_kit.html.twig' %}

{% block content %}
<div class="row justify-content-center"><div class="col-xl-7">
  <div class="card">
    <h3 class="card-header">Save your recovery codes</h3>
    <div class="card-body">
      <div class="alert alert-warning">Each code works once. These codes will not be shown again.</div>
      <ul class="list-unstyled">{% for code in recovery_codes %}<li><code>{{ code }}</code></li>{% endfor %}</ul>

      {{ form_start(acknowledgement_form) }}
        <div class="form-wrapper">{{ form_widget(acknowledgement_form) }}</div>
      {{ form_end(acknowledgement_form) }}
    </div>
  </div>
</div></div>
{% endblock %}
