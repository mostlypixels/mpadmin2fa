{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% form_theme totp_form '@PrestaShop/Admin/TwigTemplateForm/prestashop_ui_kit.html.twig' %}
{% form_theme recovery_form '@PrestaShop/Admin/TwigTemplateForm/prestashop_ui_kit.html.twig' %}

{% block content %}
<div class="row justify-content-center"><div class="col-xl-6">
  <div class="card">
    <h3 class="card-header">{{ step_up ? 'Confirm it is you to continue' : 'Two-factor authentication' }}</h3>
    <div class="card-body">
      <p>{{ step_up ? 'This important security change needs another 2FA check. Enter the current code from your authenticator app.' : 'Enter the current code from your authenticator app to finish signing in.' }}</p>
      {{ form_start(totp_form) }}
        <div class="form-wrapper">{{ form_widget(totp_form) }}</div>
      {{ form_end(totp_form) }}

      <hr>
      <details>
        <summary>Use a recovery code</summary>
        <div class="mt-3">
          {{ form_start(recovery_form) }}
            <div class="form-wrapper">{{ form_widget(recovery_form) }}</div>
          {{ form_end(recovery_form) }}
        </div>
      </details>
    </div>
  </div>
</div></div>
{% endblock %}
