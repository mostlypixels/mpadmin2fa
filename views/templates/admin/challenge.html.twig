{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% block content %}
<div class="row justify-content-center"><div class="col-xl-6">
  <div class="card">
    <h3 class="card-header">{{ step_up ? 'Confirm this sensitive action' : 'Two-factor authentication' }}</h3>
    <div class="card-body">
      {% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}
      <form method="post">
        <input type="hidden" name="mp2fa_csrf_token" value="{{ csrf_token('mp2fa_challenge') }}">
        <div class="form-group">
          <label for="mp2fa-code">Authentication code</label>
          <input id="mp2fa-code" class="form-control" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" autofocus>
        </div>
        <button class="btn btn-primary" type="submit">Verify</button>
      </form>
      <hr>
      <details>
        <summary>Use a recovery code</summary>
        <form method="post" class="mt-3">
          <input type="hidden" name="mp2fa_csrf_token" value="{{ csrf_token('mp2fa_challenge') }}">
          <div class="form-group">
            <label for="mp2fa-recovery">Recovery code</label>
            <input id="mp2fa-recovery" class="form-control" name="recovery_code" autocomplete="one-time-code">
          </div>
          <button class="btn btn-outline-primary" type="submit">Use recovery code</button>
        </form>
      </details>
    </div>
  </div>
</div></div>
{% endblock %}
