{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% form_theme confirmation_form '@PrestaShop/Admin/TwigTemplateForm/prestashop_ui_kit.html.twig' %}

{% block content %}
<div class="row justify-content-center"><div class="col-xl-7">
  <div class="card">
    <h3 class="card-header">Set up an authenticator app</h3>
    <div class="card-body">
      <div class="alert alert-info">Scan this code with your authenticator app. The secret never leaves this site.</div>
      <div class="text-center mb-3"><img src="{{ qr_data_uri }}" alt="TOTP enrollment QR code" width="260" height="260"></div>
      <p><strong>Manual key:</strong> <code>{{ secret }}</code></p>

      {{ form_start(confirmation_form) }}
        <div class="form-wrapper">{{ form_widget(confirmation_form) }}</div>
      {{ form_end(confirmation_form) }}
    </div>
  </div>
</div></div>
{% endblock %}
