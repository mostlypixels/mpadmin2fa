{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% block content %}
<div class="row justify-content-center"><div class="col-xl-7">
  <div class="card">
    <h3 class="card-header">Set up an authenticator app</h3>
    <div class="card-body">
      <div class="alert alert-info">Scan this code with your authenticator app. The secret never leaves this site.</div>
      <div class="text-center mb-3"><img src="{{ qr_data_uri }}" alt="TOTP enrollment QR code" width="260" height="260"></div>
      <p><strong>Manual key:</strong> <code>{{ secret }}</code></p>
      <form method="post">
        <input type="hidden" name="mp2fa_csrf_token" value="{{ csrf_token('mp2fa_enroll') }}">
        <div class="form-group">
          <label for="mp2fa-code">Six-digit code</label>
          <input id="mp2fa-code" class="form-control" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" required>
        </div>
        <button class="btn btn-primary" type="submit">Confirm and activate</button>
      </form>
    </div>
  </div>
</div></div>
{% endblock %}
