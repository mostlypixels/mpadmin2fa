{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% set enrollmentTabs %}
  <ul class="nav nav-pills" role="navigation" aria-label="Employee 2FA sections">
    <li class="nav-item">
      <a class="nav-link tab {{ app.request.attributes.get('_route') == 'mpadmin2fa_enrollment_employees' ? 'active current' }}" href="{{ path('mpadmin2fa_enrollment_employees') }}">Employees</a>
    </li>
    <li class="nav-item">
      <a class="nav-link tab {{ app.request.attributes.get('_route') == 'mpadmin2fa_enrollment_approvals' ? 'active current' }}" href="{{ path('mpadmin2fa_enrollment_approvals') }}">Pending approvals</a>
    </li>
  </ul>
{% endset %}
{% set headerTabContent = [enrollmentTabs] %}

{% block content %}
<div class="row"><div class="col-xl-10">
  {% block enrollment_content %}{% endblock %}
</div></div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="{{ asset('themes/default/js/bundle/pagination.js') }}"></script>
{% endblock %}
