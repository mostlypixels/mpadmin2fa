{% extends '@Modules/mpadmin2fa/views/templates/admin/enrollment/layout.html.twig' %}

{% block enrollment_content %}
{% if pending_approvals is empty %}
  <p class="mb-0">No approvals are pending.</p>
{% else %}
  <div class="table-responsive"><table class="table mb-0">
    <thead><tr><th>Employee</th><th>Requested</th>{% if can_approve %}<th>Action</th>{% endif %}</tr></thead>
    <tbody>{% for item in pending_approvals %}<tr>
      <td>{{ item.id_employee }} - {{ item.firstname }} {{ item.lastname }}<br><small>{{ item.email }}</small></td>
      <td>{{ item.date_add }}</td>
      {% if can_approve %}<td>
        <form method="post" action="{{ path('mpadmin2fa_approve', {employeeId: item.id_employee}) }}">
          <input type="hidden" name="mp2fa_csrf_token" value="{{ csrf_token('mp2fa_approve_' ~ item.id_employee) }}">
          <button class="btn btn-sm btn-primary">Approve</button>
        </form>
      </td>{% endif %}
    </tr>{% endfor %}</tbody>
  </table></div>
{% endif %}
{% endblock %}
