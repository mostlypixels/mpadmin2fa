{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% block content %}
<div class="row"><div class="col-xl-8">
  <div class="card mb-3">
    <h3 class="card-header">Your authenticator</h3>
    <div class="card-body">
      <p>Status: <strong>{{ active ? 'Active' : 'Not enrolled' }}</strong></p>
      {% if active %}
      <form method="post" action="{{ path('mpadmin2fa_replace') }}" class="mb-4">
        <input type="hidden" name="mp2fa_csrf_token" value="{{ csrf_token('mp2fa_replace') }}">
        <h4>Replace authenticator</h4>
        <input class="form-control mb-2" type="password" name="password" placeholder="Current password{% if not password_required %} (optional for this recent login){% endif %}" {% if password_required %}required {% endif %}autocomplete="current-password">
        <input class="form-control mb-2" name="code" placeholder="Current six-digit code" required inputmode="numeric" autocomplete="one-time-code">
        <button class="btn btn-outline-primary">Replace</button>
      </form>
      <form method="post" action="{{ path('mpadmin2fa_recovery_regenerate') }}" class="mb-4">
        <input type="hidden" name="mp2fa_csrf_token" value="{{ csrf_token('mp2fa_recovery_regenerate') }}">
        <h4>Replace recovery codes</h4>
        <p>This invalidates every existing recovery code.</p>
        <input class="form-control mb-2" type="password" name="password" placeholder="Current password{% if not password_required %} (optional for this recent login){% endif %}" {% if password_required %}required {% endif %}autocomplete="current-password">
        <input class="form-control mb-2" name="code" placeholder="Current six-digit code" required inputmode="numeric" autocomplete="one-time-code">
        <button class="btn btn-outline-primary">Generate replacement codes</button>
      </form>
      <form method="post" action="{{ path('mpadmin2fa_disable') }}">
        <input type="hidden" name="mp2fa_csrf_token" value="{{ csrf_token('mp2fa_disable') }}">
        <h4>Disable authenticator</h4>
        <input class="form-control mb-2" type="password" name="password" placeholder="Current password{% if not password_required %} (optional for this recent login){% endif %}" {% if password_required %}required {% endif %}autocomplete="current-password">
        <input class="form-control mb-2" name="code" placeholder="Current six-digit code" required inputmode="numeric" autocomplete="one-time-code">
        <button class="btn btn-outline-danger">Disable</button>
      </form>
      {% else %}
        <a class="btn btn-primary" href="{{ path('mpadmin2fa_enroll') }}">Set up authenticator</a>
      {% endif %}
    </div>
  </div>

  {% if is_superadmin %}
  <div class="card mb-3">
    <h3 class="card-header">Global policy</h3>
    <div class="card-body">
      <form method="post">
        <input type="hidden" name="mp2fa_csrf_token" value="{{ csrf_token('mp2fa_settings') }}">
        <label>Login enforcement</label>
        <select class="form-control mb-2" name="mode">
          <option value="superadmins" {{ mode == 'superadmins' ? 'selected' }}>SuperAdmins</option>
          <option value="profiles" {{ mode == 'profiles' ? 'selected' }}>Selected profile IDs</option>
          <option value="all" {{ mode == 'all' ? 'selected' }}>All employees</option>
        </select>
        <label>Profile IDs (comma separated)</label>
        <input class="form-control mb-2" name="profiles" value="{{ profiles }}">
        <label>Fresh verification lifetime (seconds)</label>
        <input class="form-control mb-2" type="number" min="60" name="step_up_seconds" value="{{ step_up_seconds }}">
        <label>Native password-authentication maximum age (seconds)</label>
        <input class="form-control mb-2" type="number" min="60" name="password_max_age" value="{{ password_max_age }}">
        <label>Profiles requiring first-enrollment approval (comma separated)</label>
        <input class="form-control mb-2" name="approval_profiles" value="{{ approval_profiles }}">
        <label>Audit retention (days)</label>
        <input class="form-control mb-2" type="number" min="1" name="audit_days" value="{{ audit_days }}">
        <label>Security alert recipients (comma separated)</label>
        <input class="form-control mb-3" name="security_recipients" value="{{ security_recipients }}">
        <button class="btn btn-primary">Save policy</button>
      </form>
    </div>
  </div>

  <div class="card mb-3">
    <h3 class="card-header">Pending enrollment approvals</h3>
    <div class="card-body">
      {% if pending_approvals is empty %}<p class="mb-0">No approvals are pending.</p>{% endif %}
      {% for item in pending_approvals %}
        <form method="post" action="{{ path('mpadmin2fa_approve', {employeeId: item.id_employee}) }}" class="d-flex justify-content-between mb-2">
          <span>{{ item.firstname }} {{ item.lastname }} ({{ item.email }})</span>
          <input type="hidden" name="mp2fa_csrf_token" value="{{ csrf_token('mp2fa_approve_' ~ item.id_employee) }}">
          <button class="btn btn-sm btn-primary">Approve</button>
        </form>
      {% endfor %}
    </div>
  </div>

  <div class="card mb-3">
    <h3 class="card-header">Employees</h3>
    <div class="card-body table-responsive"><table class="table">
      <thead><tr><th>Employee</th><th>Profile</th><th>Status</th><th></th></tr></thead>
      <tbody>{% for item in employees %}<tr>
        <td>{{ item.firstname }} {{ item.lastname }}<br><small>{{ item.email }}</small></td>
        <td>{{ item.id_profile }}</td><td>{{ item.status|default('not enrolled') }}</td>
        <td>{% if item.status and item.id_employee != app.user.id %}
          <form method="post" action="{{ path('mpadmin2fa_admin_reset', {employeeId: item.id_employee}) }}">
            <input type="hidden" name="mp2fa_csrf_token" value="{{ csrf_token('mp2fa_admin_reset_' ~ item.id_employee) }}">
            <button class="btn btn-sm btn-outline-danger">Reset factor</button>
          </form>{% endif %}</td>
      </tr>{% endfor %}</tbody>
    </table></div>
  </div>

  <div class="card">
    <h3 class="card-header">Recent security events</h3>
    <div class="card-body table-responsive"><table class="table">
      <thead><tr><th>Time</th><th>Employee</th><th>Event</th><th>IP</th></tr></thead>
      <tbody>{% for event in audit_events %}<tr><td>{{ event.date_add }}</td><td>{{ event.id_employee }}</td><td>{{ event.event }}</td><td>{{ event.ip }}</td></tr>{% endfor %}</tbody>
    </table></div>
  </div>
  {% endif %}
</div></div>
{% endblock %}
