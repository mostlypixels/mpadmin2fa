{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% block content %}
<div class="row"><div class="col-xl-10">
  <div class="card">
    <h3 class="card-header">Admin 2FA</h3>
    <div class="card-body">
      <p class="lead">Protect back-office accounts with an authenticator app, recovery codes, and another 2FA check before important security changes.</p>
      <h4 class="mt-4">{{ authenticator_active ? 'Manage and strengthen 2FA' : 'Get started' }}</h4>
      <div class="row">
        <div class="col-lg-4 mb-3">
          <div class="card d-flex flex-column h-100">
            <div class="card-body">
              {% if authenticator_active %}
                <h4>1. Your account is protected</h4>
                <p>Your authenticator is connected. Open it to manage your authenticator and recovery codes.</p>
              {% else %}
                <h4>1. Protect your account</h4>
                <p>Connect an authenticator app, verify the first code, and save the recovery codes when they are shown.</p>
              {% endif %}
            </div>
            <div class="card-footer d-flex justify-content-end mt-auto">
              {% if can_open_authenticator %}
                <a class="btn btn-primary" href="{{ path('mpadmin2fa_authenticator') }}">{{ authenticator_active ? 'Manage your authenticator' : 'Set up your authenticator' }}</a>
              {% else %}
                <span class="text-muted">This section is not available to your profile.</span>
              {% endif %}
            </div>
          </div>
        </div>
        <div class="col-lg-4 mb-3">
          <div class="card d-flex flex-column h-100">
            <div class="card-body">
              <h4>2. Prepare the rollout</h4>
              <p>Review employee 2FA setup, approve requests when required, and make sure another trusted administrator can recover access.</p>
            </div>
            <div class="card-footer d-flex justify-content-end mt-auto">
              {% if can_open_enrollment %}
                <a class="btn btn-outline-primary" href="{{ path('mpadmin2fa_enrollment_employees') }}">Review employee 2FA</a>
              {% else %}
                <span class="text-muted">This section is not available to your profile.</span>
              {% endif %}
            </div>
          </div>
        </div>
        <div class="col-lg-4 mb-3">
          <div class="card d-flex flex-column h-100">
            <div class="card-body">
              <h4>3. Set the security rules</h4>
              <p>Decide who must use 2FA, choose how long confirmations stay valid, and review the security activity log.</p>
            </div>
            <div class="card-footer d-flex justify-content-end mt-auto">
              {% if can_open_security %}
                <a class="btn btn-outline-primary" href="{{ path('mpadmin2fa_security_policy') }}">Configure 2FA rules</a>
              {% else %}
                <span class="text-muted">This section is not available to your profile.</span>
              {% endif %}
            </div>
          </div>
        </div>
      </div>

      {% if not https_configured or not https_active %}
        <div class="alert alert-danger mt-3" role="alert">
          <h4 class="alert-heading">HTTPS needs attention</h4>
          {% if not https_configured %}
            <p class="mb-0">HTTPS is not enabled in PrestaShop settings. Enable SSL under Shop Parameters &gt; General before requiring 2FA.</p>
          {% else %}
            <p class="mb-0">HTTPS is enabled in PrestaShop, but this back-office page is not secure. Ask your hosting provider or technical contact to check the web server or proxy before requiring 2FA.</p>
          {% endif %}
        </div>
      {% endif %}

      <div class="row mt-3">
        <div class="col-6">
          <div class="alert alert-warning h-100 mb-0">
            <h4 class="alert-heading">Before requiring 2FA</h4>
            <ul class="mb-0">
              <li>Set up 2FA for at least two trusted SuperAdmins so one person can recover the other.</li>
              <li>Store recovery codes somewhere secure outside PrestaShop. They are shown only once.</li>
              <li>Test a complete sign-in in a private browser window before requiring 2FA for employees.</li>
              <li>Ask your hosting provider to keep the server time automatic and accurate; authenticator codes depend on it.</li>
            </ul>
          </div>
        </div>
        <div class="col-6">
          <h4>What changes after 2FA is set up?</h4>
          <p class="mb-0">After entering their password, protected employees also enter the current six-digit code from their authenticator app. Important module and theme changes may ask for another 2FA code. These checks appear in the security activity log.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="card mt-3">
    <h3 class="card-header">Security emails: what to do</h3>
    <div class="card-body">
      <p>Most security emails go to the affected employee and the addresses entered under Security alert recipients. The urgent successful-login alert goes only to the Security alert recipients.</p>
      <div class="table-responsive">
        <table class="table table-striped mb-0">
          <thead>
            <tr>
              <th scope="col">Email</th>
              <th scope="col">Priority</th>
              <th scope="col">What it means</th>
              <th scope="col">What to do</th>
            </tr>
          </thead>
          <tbody>
            {% for alert in security_alerts %}
            <tr>
              <td><strong>{{ alert.title }}</strong></td>
              <td><span class="badge {{ alert.badge_class }}">{{ alert.priority }}</span></td>
              <td>{{ alert.meaning }}</td>
              <td>{{ alert.action }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div></div>
{% endblock %}
